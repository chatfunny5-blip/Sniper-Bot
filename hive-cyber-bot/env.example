# Discord Bot Token (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your-discord-bot-token

# Optional but strongly recommended: Hive API key.
# Without it, the rate limit is very low. Request one at: api@hivemc.com
HIVE_API_KEY=

# How often (in seconds) tracked players are checked for stat changes.
# Requests are staggered across this interval, AND each player has its own
# in-memory exponential backoff if it hits a 429 rate limit (see
# cogs/tracking.py docstring) — so pushing this low is safe to try even
# without a HIVE_API_KEY. Worst case, a specific player self-throttles for
# a while instead of the whole bot erroring out.
#
#   Without HIVE_API_KEY, 1 player   -> 15s is a safe starting point
#   Without HIVE_API_KEY, 2+ players -> stick closer to 30-45s
#   With HIVE_API_KEY                -> 5-10s is realistic
POLL_INTERVAL_SECONDS=15

# Optional fallback channel ID if /track somehow runs without channel context
ALERT_CHANNEL_ID=

# Where the tracked-player watchlist is stored
# On Railway: mount a Volume here, otherwise the list is lost on every redeploy!
DATA_FILE=data/tracked.json
